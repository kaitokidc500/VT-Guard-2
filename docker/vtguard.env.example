# VT-Guard - mau file env cho che do live (docs/STEP9-M4-LAB.md). Chep thanh secrets/vtguard.env (thu muc secrets/ nam ngoai git),
# dien mat khau, KHONG commit file da dien. Chay Python tren host: duong dan CA kieu G:/VT-Guard/secrets/root-ca.pem;
# chay Docker: mount secrets/ vao /secrets va dung /secrets/root-ca.pem.
VTG_INDEXER_URL=https://10.20.30.10:9200
VTG_INDEXER_USER=vtguard
VTG_INDEXER_PASSWORD=
VTG_INDEXER_CA=/secrets/root-ca.pem
# Chung chi wazuh-docker cap cho CN 'wazuh.indexer': noi bang IP thi tat kiem ten may (van kiem CA)
VTG_INDEXER_CHECK_HOSTNAME=0
VTG_AGENTS=DC01,WIN10-01
