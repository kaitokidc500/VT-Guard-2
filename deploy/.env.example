# Sao chep thanh deploy/.env roi sua cho dung VT-SIEM01 (file .env nam ngoai git).
# Ten mang Docker cua wazuh-docker (docker network ls | grep single-node)
WAZUH_NET=single-node_default
# Thu muc chung chi Indexer cua wazuh-docker (chua root-ca.pem)
WAZUH_CERTS=/home/vt_admin/wazuh-docker/single-node/config/wazuh_indexer_ssl_certs
# Dashboard VT-Guard: dia chi + cong rieng tren VT-SIEM01
VTG_BIND=10.20.30.10
VTG_PORT=8501
# Chu ky doc Indexer (giay) va ghi nguoc vtguard-alerts-* (--push-alerts hoac --no-push-alerts)
VTG_POLL=12
VTG_PUSH=--push-alerts
