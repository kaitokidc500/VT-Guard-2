# Sao chep thanh deploy/secrets/vtguard.env, dien mat khau tai khoan Indexer rieng 'vtguard' (KHONG commit).
# Trong mang Docker cua Wazuh, Indexer co ten wazuh.indexer = CN cua chung chi -> kiem TLS day du.
VTG_INDEXER_URL=https://wazuh.indexer:9200
VTG_INDEXER_USER=vtguard
VTG_INDEXER_PASSWORD=
VTG_INDEXER_CA=/secrets/root-ca.pem
VTG_AGENTS=DC01,WIN10-01
